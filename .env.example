# ── Wallet ────────────────────────────────────────────────────────────────
# Base58 secret key. REQUIRED only to execute (src/execute.js). The scanner
# and proposal steps never touch this — they run read-only.
PRIVATE_KEY=

# Solana RPC. Public default is rate-limited; use a paid endpoint for live use.
RPC_URL=https://api.mainnet-beta.solana.com

# ── Safety (all enforced in src/execution/traderouter.js) ──────────────────
# Live trading is OFF unless you set this to exactly "false".
DRY_RUN=true

# Per-trade and portfolio caps. Sizes are in SOL.
MAX_BUY_SOL=0.10          # hard ceiling per single buy
BANKROLL_SOL=1.0          # total capital the desk is allowed to reason about
MAX_DEPLOYED_SOL=0.5      # max simultaneously deployed across all positions
MAX_POSITIONS=5           # max concurrent open proposals to fund
MAX_DAILY_LOSS_SOL=0.25   # kill-switch trips when realized loss exceeds this
DEFAULT_SLIPPAGE_BPS=1500 # 15% — memecoins need headroom (skill guidance)

# ── Signal filters (scanner / risk gates) ──────────────────────────────────
MIN_LIQUIDITY_USD=25000   # skip pools thinner than this (rug / slippage risk)
MAX_FDV_USD=15000000      # skip tokens already too big to move
MIN_AGE_MINUTES=15        # avoid the first minutes (highest rug window)
MAX_AGE_HOURS=72          # avoid stale, dead-cat tokens
MIN_VOL_H1_USD=20000      # require real recent volume

# Take-profit / stop-loss placed as limit orders after a fill (bps vs entry mcap)
TP_BPS=20000              # 20000 = take profit when mcap doubles
SL_BPS=6000               # 6000  = stop out when mcap falls to 60%

# ── Paper / forward-test realism ────────────────────────────────────────────
PAPER_FRICTION_BPS=500    # 5% round-trip slippage+fees subtracted from every paper result
PAPER_EXPIRY_HOURS=24     # close still-open paper positions at current mark after this

# ── Server signature trust anchor (TradeRouter) ────────────────────────────
TRADEROUTER_SERVER_PUBKEY=EXX3nRzfDUvbjZSmxFzHDdiSYeGVP1EGr77iziFZ4Jd4
TRADEROUTER_REQUIRE_SERVER_SIGNATURE=true
